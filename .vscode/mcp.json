{
  "servers": {
    "brimble": {
      "type": "http",
      "url": "https://mcp.brimble.io",
      "headers": {
        "Authorization": "Bearer ${input:brimbleApiKey}"
      }
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "brimbleApiKey",
      "description": "Brimble API key",
      "password": true
    }
  ]
}